{
  "compilerOptions": {
    "typeRoots": [
      "./types/**/*",
      "./node_modules/@types"
    ],
    "declaration": true,
    "emitDeclarationOnly": false,
    "module": "esnext",
    "moduleResolution": "node16",
    "target": "esnext",
    "esModuleInterop": true,
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true
  }
}